# RuralBiz Navigator Environment Configuration
# All keys are optional. The application functions completely in Offline Demo Mode without any keys.

# AI Provider API Keys
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Preferred AI Provider: auto | groq | openai | gemini | mock
DEFAULT_AI_PROVIDER=auto

# Application Environment: development | production
APP_ENV=development